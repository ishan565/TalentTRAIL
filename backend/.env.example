# ============================================================
# TalentTrail — Backend environment configuration
# Copy this file to `.env` and fill in real values.
# ============================================================

# ---- App ----
APP_NAME="TalentTrail"
ENVIRONMENT=development            # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- Database ----
# Dev (SQLite). For Postgres use:
# postgresql+psycopg2://talenttrail:talenttrail@localhost:5432/talenttrail
DATABASE_URL=sqlite:///./talenttrail.db

# ---- LLM Provider ----
# Provider selector: "azure" (you have Azure keys) or "ollama"
LLM_PROVIDER=azure
# Set to false ONLY on a dev machine behind a corporate proxy that intercepts SSL
# (otherwise Azure calls fail and agents fall back to baseline content).
LLM_VERIFY_SSL=true

# ---- Azure OpenAI (primary) ----
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Chat/completions deployment name (azure.openai.deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Embeddings deployment name (optional; falls back to hashing embedder if unset)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Ollama (optional local fallback) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Vector store ----
CHROMA_PERSIST_DIR=./.chroma

# ---- File storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Live job sources ----
# Fetch real, latest jobs/internships from public APIs (Remotive, Jobicy, Arbeitnow).
USE_LIVE_JOBS=true
# Set to false ONLY on a dev machine behind a corporate proxy that intercepts SSL.
JOB_API_VERIFY_SSL=true
# Google Jobs via SerpApi (https://serpapi.com) — real Google job results with
# full JDs, India-aware. Get a free key (100 searches/mo) and paste it here.
# When empty, the app falls back to the free public APIs above.
SERPAPI_KEY=
# Default location used when the user doesn't type one.
DEFAULT_JOB_LOCATION=India

# ---- Observability (LangSmith optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=talenttrail
